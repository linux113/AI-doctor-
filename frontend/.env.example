# Browser-visible API base URL.
# Leave empty for local development through the Next.js proxy.
# For Amplify, set this to the deployed API Gateway URL, for example:
# NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=

# Server-side proxy origin used by next.config.js/middleware.ts.
# Set this in Amplify if you want to keep using same-origin /api rewrites.
AIDOCTOR_BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional server-side bearer token. Never expose this as NEXT_PUBLIC_*.
# AIDOCTOR_API_TOKEN=
